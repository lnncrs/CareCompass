
CARECOMPASS_APP_NAME=Care Compass

# Motor: echo funciona sem credenciais; langgraph usa o modelo real.
CARECOMPASS_CHAT_ENGINE=echo

# Opcional: caminho do catálogo JSON (padrão: data/processed/services.sample.json na raiz).
# CARECOMPASS_CATALOG_PATH=C:/caminho/para/services.sample.json

# Prompt lido uma vez ao iniciar. Caminho padrão: backend/prompts/assistant.md.
# CARECOMPASS_PROMPT_PATH=C:/caminho/para/assistant.md

# Contatos públicos lidos na inicialização do motor LangGraph; não são secrets.
# CARECOMPASS_SUPPORT_CONTACTS_PATH=C:/caminho/para/support_contacts.json

# Inferência direta OpenAI-compatible v1, NÃO o endpoint /api/projects/.
# Base completa, incluindo /openai/v1/. Sem /chat/completions no final.
CARECOMPASS_FOUNDRY_BASE_URL=

# Nome da implantação (deployment), não necessariamente o nome do modelo.
CARECOMPASS_FOUNDRY_DEPLOYMENT=

# Preencha apenas no .env local. Nunca versionar valores reais.
CARECOMPASS_FOUNDRY_API_KEY=

# API v1: não precisa de api-version. Nesta fase, autenticação por chave.
CARECOMPASS_AGENT_TIMEOUT_SECONDS=15
CARECOMPASS_AGENT_MAX_STEPS=6
CARECOMPASS_AGENT_MAX_OUTPUT_TOKENS=600
